if (title.equals("§8Confirmar troca")) {
    e.setCancelled(true);

    String id = pending.get(p.getUniqueId());
    if (id == null) return;

    if (e.getRawSlot() == 13) {
        purchase(p, id);
    } else if (e.getRawSlot() == 22) {
        pending.remove(p.getUniqueId());
        p.closeInventory();
        p.sendMessage("§cCompra cancelada!");
    }
    return;
}
